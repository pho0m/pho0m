# Build-time settings for the site and the admin page. Vite bakes them into the JavaScript,
# so put only public values here. For local overrides copy this file to web/.env.local
# (git ignores it). In CI the Deploy workflow sets both values for you.

# Base URL of the admin API on Cloud Run, without a trailing slash,
# e.g. https://pho0m-api-xxxxxxxxxx-as.a.run.app
# Empty → the admin page calls /api on the same origin; `npm run dev` proxies that to the
# local API at http://localhost:8787 (start it with `npm run dev:api`).
VITE_API_URL=

# Public URL of the live content JSON that the admin API writes:
#   https://storage.googleapis.com/<bucket>/content/site.json
# With the local API (no bucket) it is http://localhost:8787/files/content/site.json
# Empty → the site shows only the built-in content from content/seed.json.
VITE_CONTENT_URL=
