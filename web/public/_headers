# Cloudflare Pages response headers. Vite copies this file from web/public into web/dist.
# Pages already serves HTML with "Cache-Control: public, max-age=0, must-revalidate".
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed build output: safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed names that can change between deploys.
/img/*
  Cache-Control: public, max-age=86400
/media/*
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# SEO and AI-crawler files (rebuilt on every deploy and content refresh).
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# The admin: never indexed, never framed.
/admin
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
/admin.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
/admin/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
