# Admin API configuration. Copy to api/.env for local dev (npm run dev -w api loads it).
# On Cloud Run set these as environment variables / secrets instead. Never commit real values.

# --- Login ---------------------------------------------------------------------------------
# Password for the admin page. Empty → POST /api/auth/login answers 503.
ADMIN_PASSWORD=

# Optional HS256 secret for session tokens (12 h). Empty → derived with HMAC-SHA256 from the
# service-account private key, or from ADMIN_PASSWORD when there is no key.
# Changing it (or the password, when derived from it) signs everyone out.
SESSION_SECRET=

# --- Storage -------------------------------------------------------------------------------
# Google Cloud Storage bucket that holds content/site.json, content/history/ and media/.
# Empty → "local" driver: files go to DATA_DIR and are served at http://localhost:PORT/files/…
SERVICE_ACCOUNT_BUCKET_NAME=

# Service-account key JSON for that bucket: paste the raw JSON on one line, or base64 of it
# (base64 -w0 key.json). Empty with a bucket set → Application Default Credentials
# (on Cloud Run: the service's own service account; locally: gcloud auth application-default login).
SERVICE_ACCOUNT_KEY=

# Local driver folder (default: api/.data).
DATA_DIR=

# --- HTTP ----------------------------------------------------------------------------------
# Port to listen on (default 8787; Cloud Run sets 8080).
PORT=

# Base URL used for local-driver file URLs (default http://localhost:PORT).
PUBLIC_BASE_URL=

# Comma-separated origins allowed to call the API from a browser. Setting it replaces the defaults:
# https://kiattiphoom-pho0m.web.app,https://kiattiphoom-pho0m.firebaseapp.com,http://localhost:5173,http://localhost:4173
ALLOWED_ORIGINS=

# --- Site rebuild after a save (optional) -------------------------------------------------
# Fine-grained GitHub token limited to the pho0m/pho0m repository with
# "Contents: Read and write" (needed for repository_dispatch). When set, every successful save
# sends a "content-updated" repository_dispatch (at most one per 5 minutes, plus one trailing
# call), which rebuilds the site's SEO/AI files and the README. Empty → off. Never logged.
GITHUB_DISPATCH_TOKEN=

# Repository that receives the dispatch, as owner/repo (default pho0m/pho0m).
GITHUB_REPOSITORY=
