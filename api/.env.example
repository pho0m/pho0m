# Admin API configuration. Copy to api/.env for local dev (npm run dev -w api loads it).
# On Cloud Run set these as environment variables / secrets instead. Never commit real values.

# --- Login ---------------------------------------------------------------------------------
# Password for the admin page. Empty → POST /api/auth/login answers 503.
ADMIN_PASSWORD=

# Server secret, at least 32 characters. Generate one with: openssl rand -hex 32
# It signs the 12 h session tokens and (through HKDF) encrypts the private copy of the content
# (private/content.enc: drafts, hidden items, hidden email/phone) and its history.
# Empty → derived from the service-account private key when SERVICE_ACCOUNT_KEY is set,
# otherwise a random secret for this process only: every restart (and `npm run dev:api`
# restarts on each code change) logs you out and leaves earlier drafts unreadable.
# Never derived from ADMIN_PASSWORD. Set it in production.
# Changing it signs everyone out and makes saved drafts unreadable: the admin then shows the
# published version and the next save starts over with the new secret (see api/README.md).
SESSION_SECRET=

# --- Storage -------------------------------------------------------------------------------
# Google Cloud Storage bucket that holds content/site.json (public projection), private/
# (encrypted full content and history) and media/.
# Empty → "local" driver: files go to DATA_DIR and are served at http://localhost:PORT/files/…
SERVICE_ACCOUNT_BUCKET_NAME=

# Service-account key JSON for that bucket: paste the raw JSON on one line, or base64 of it
# (base64 -w0 key.json). Empty with a bucket set → Application Default Credentials
# (on Cloud Run: the service's own service account; locally: gcloud auth application-default login).
SERVICE_ACCOUNT_KEY=

# Local driver folder (default: api/.data).
DATA_DIR=

# --- HTTP ----------------------------------------------------------------------------------
# Port to listen on (default 8787; Cloud Run sets 8080).
PORT=

# Base URL used for local-driver file URLs (default http://localhost:PORT).
PUBLIC_BASE_URL=

# Comma-separated origins allowed to call the API from a browser. Setting it replaces the defaults:
# https://pho0m.kiattiphoom.workers.dev,http://localhost:5173,http://localhost:4173
ALLOWED_ORIGINS=

# --- Site rebuild after a save (optional) -------------------------------------------------
# Fine-grained GitHub token limited to the pho0m/pho0m repository with
# "Contents: Read and write" (needed for repository_dispatch). When set, a successful save
# sends a "content-updated" repository_dispatch and waits for GitHub (at most 4 s) before it
# answers. At most one call per 2 minutes: a save inside that window is queued and sent with the
# next save after it. This rebuilds the site's SEO/AI files and the README. Empty → off. Never logged.
GITHUB_DISPATCH_TOKEN=

# Repository that receives the dispatch, as owner/repo (default pho0m/pho0m).
GITHUB_REPOSITORY=
